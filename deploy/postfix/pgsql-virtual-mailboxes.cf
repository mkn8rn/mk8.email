hosts = unix:/run/postgresql
user = postfix
dbname = mk8email
query = SELECT 1 FROM inboxes i JOIN addresses a ON a.id = i.address_id JOIN companies c ON c.id = a.company_id JOIN users u ON u.id = i.owner_id WHERE i.name = lower('%u') AND a.domain = lower('%d') AND i.alias_for_inbox_id IS NULL AND a.is_active AND c.is_active AND u.is_active
expansion_limit = 1
