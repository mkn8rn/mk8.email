{
  "Database": {
    "Host": "127.0.0.1",
    "Port": 5432,
    "Name": "mk8email",
    "Username": "mk8email",
    "PasswordFile": "/etc/mk8email/secrets/database_password"
  },
  "Smtp": {
    "Hostname": "mail.mk8n.com",
    "Port": 25,
    "SubmissionPort": 587,
    "ImplicitTlsPort": 465,
    "EnableSmtp": true,
    "EnableSubmission": true,
    "EnableImplicitTls": true,
    "EnableStartTls": true,
    "RequireTls": false,
    "RequireAuth": true,
    "AllowRelay": true
  },
  "Imap": {
    "Port": 143,
    "ImplicitTlsPort": 993,
    "EnableImap": false,
    "EnableImplicitTls": true
  },
  "Tls": {
    "CertificatePath": "/etc/mk8email/tls/fullchain.pem",
    "CertificateKeyPath": "/etc/mk8email/tls/privkey.pem"
  },
  "Dkim": {
    "PrivateKeyPath": "/etc/mk8email/dkim/s202609.private.pem",
    "Selector": "s202609",
    "EnableSigning": true
  },
  "Security": {
    "EnableSpfCheck": false,
    "EnableDmarcCheck": false,
    "PasswordHashScheme": "BLF-CRYPT"
  },
  "Limits": {
    "MaxMessageSizeBytes": 26214400,
    "MaxRecipientsPerMessage": 100,
    "ConnectionTimeoutSeconds": 300,
    "MaxConnectionsPerIp": 20
  },
  "General": {
    "AllowRegistration": false
  },
  "Admin": {
    "AllowedNetworks": [
      "127.0.0.0/8",
      "192.0.2.0/24"
    ],
    "DataProtectionKeyPath": "/var/lib/mk8email-admin/data-protection",
    "AuditLogPath": "/var/log/mk8email-admin/audit.jsonl",
    "HealthStatusPath": "/var/lib/mk8-mail-health/status.json",
    "SessionMinutes": 30
  }
}
