[DEFAULT]
backend = auto
banaction = nftables-multiport
bantime = 1h
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.0/8 ::1 @@MK8_TRUSTED_ADMIN_IPV4@@

[sshd]
enabled = true
backend = systemd
mode = aggressive
maxretry = 4

[nginx-http-auth]
enabled = true

[nginx-botsearch]
enabled = true

[postfix]
enabled = true
backend = systemd
mode = more
maxretry = 8

[postfix-sasl]
enabled = true
backend = systemd
maxretry = 5

[dovecot]
enabled = true
backend = systemd
maxretry = 5
