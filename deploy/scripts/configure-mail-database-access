#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "Run this command as root." >&2
    exit 2
fi

if ! runuser -u postgres -- psql --dbname=mk8email --no-psqlrc --tuples-only --no-align \
    --command="SELECT to_regclass('public.companies') IS NOT NULL AND to_regclass('public.addresses') IS NOT NULL AND to_regclass('public.users') IS NOT NULL AND to_regclass('public.inboxes') IS NOT NULL" \
    | grep -qx t; then
    printf '%s\n' "The mk8.email schema is not ready." >&2
    exit 1
fi

runuser -u postgres -- psql --dbname=mk8email --no-psqlrc --set=ON_ERROR_STOP=1 <<'SQL'
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE usename IN ('postfix', 'dovecot')
  AND pid <> pg_backend_pid();

DO $cleanup$
DECLARE
    legacy_role text;
BEGIN
    FOREACH legacy_role IN ARRAY ARRAY['postfix', 'dovecot']
    LOOP
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = legacy_role) THEN
            EXECUTE format('DROP OWNED BY %I', legacy_role);
            EXECUTE format('DROP ROLE %I', legacy_role);
        END IF;
    END LOOP;
END
$cleanup$;

ALTER ROLE mk8email NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
ALTER ROLE mk8email CONNECTION LIMIT 100;
ALTER ROLE mk8email SET statement_timeout TO '120s';
ALTER ROLE mk8email SET lock_timeout TO '10s';
SQL

printf '%s\n' "The native mail database access is ready."
