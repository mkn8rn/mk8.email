#!/bin/sh
set -eu

export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ] || [ "$1" != mail ]; then
    printf '%s\n' "Usage: deploy-mk8-certificate mail" >&2
    exit 2
fi
certificate_target=$1

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

case "$1" in
    mail)
        lineage=${RENEWED_LINEAGE:-/etc/letsencrypt/live/mk8-mail}
        destination=/etc/mk8email/tls
        spool_destination=/var/spool/postfix/etc/mk8email/tls
        owner=root
        group=tlskeys
        directory_mode=0751
        certificate_mode=0444
        private_mode=0440
        required_names="email.mk8n.com"
        getent group tlskeys >/dev/null || groupadd --system tlskeys
        ;;
    *)
        printf '%s\n' "The certificate target is not valid." >&2
        exit 2
        ;;
esac

case "$lineage" in
    /*) ;;
    *) fail "The certificate lineage path must be absolute." ;;
esac

for required_command in flock nginx openssl systemctl timeout; do
    command -v "$required_command" >/dev/null \
        || fail "A required certificate command is missing: $required_command"
done
if [ "$1" = mail ]; then
    for required_command in doveconf postfix; do
        command -v "$required_command" >/dev/null \
            || fail "A required certificate command is missing: $required_command"
    done
fi

exec 9>/run/lock/mk8-certificate.lock
flock --exclusive --nonblock 9 \
    || fail "Another certificate deployment is active."

check_lineage_file() {
    checked_file=$1
    private_file=$2
    resolved_file=$(readlink -f -- "$checked_file") \
        || fail "A certificate lineage file cannot be resolved."
    [ -f "$resolved_file" ] \
        || fail "The certificate lineage is incomplete."
    [ ! -L "$resolved_file" ] \
        || fail "A certificate lineage target must be a regular file."
    [ "$(stat -c '%U:%G' "$resolved_file")" = root:root ] \
        || fail "Root must own each certificate lineage file."
    if find "$resolved_file" -prune -perm /022 -print -quit | grep -q .; then
        fail "Another identity can write a certificate lineage file."
    fi
    if [ "$private_file" = true ] \
        && find "$resolved_file" -prune -perm /077 -print -quit | grep -q .; then
        fail "Another identity can read the certificate private key."
    fi
}

check_lineage_file "$lineage/fullchain.pem" false
check_lineage_file "$lineage/privkey.pem" true

work=$(mktemp -d /run/mk8-certificate.XXXXXX)
completed=false
changed=false
reload_attempted=false
destination_created=false
spool_destination_created=false
nginx_active=false
postfix_active=false
dovecot_active=false

destination_certificate_new="$destination/fullchain.pem.mk8-new"
destination_private_new="$destination/privkey.pem.mk8-new"
destination_certificate_rollback="$destination/fullchain.pem.mk8-rollback"
destination_private_rollback="$destination/privkey.pem.mk8-rollback"
spool_certificate_new=
spool_private_new=
spool_certificate_rollback=
spool_private_rollback=
if [ -n "$spool_destination" ]; then
    spool_certificate_new="$spool_destination/fullchain.pem.mk8-new"
    spool_private_new="$spool_destination/privkey.pem.mk8-new"
    spool_certificate_rollback="$spool_destination/fullchain.pem.mk8-rollback"
    spool_private_rollback="$spool_destination/privkey.pem.mk8-rollback"
fi

restore_snapshot() {
    restored_path=$1
    snapshot_name=$2
    rollback_path=$3
    [ -f "$work/$snapshot_name.checked" ] || return 0
    rm -f -- "$rollback_path"
    if [ -f "$work/$snapshot_name.present" ]; then
        cp -p -- "$work/$snapshot_name" "$rollback_path"
        mv -f -- "$rollback_path" "$restored_path"
    else
        rm -f -- "$restored_path"
    fi
}

reload_active_services() {
    reload_status=0
    if [ "$nginx_active" = true ]; then
        systemctl reload nginx.service || reload_status=1
    fi
    if [ "$postfix_active" = true ]; then
        systemctl reload postfix.service || reload_status=1
    fi
    if [ "$dovecot_active" = true ]; then
        systemctl reload dovecot.service || reload_status=1
    fi
    return "$reload_status"
}

restore_previous_certificate() {
    restore_status=0
    restore_snapshot "$destination/fullchain.pem" destination-fullchain \
        "$destination_certificate_rollback" || restore_status=1
    restore_snapshot "$destination/privkey.pem" destination-privkey \
        "$destination_private_rollback" || restore_status=1
    rm -f -- "$destination_certificate_new" "$destination_private_new"

    if [ -n "$spool_destination" ]; then
        restore_snapshot "$spool_destination/fullchain.pem" spool-fullchain \
            "$spool_certificate_rollback" || restore_status=1
        restore_snapshot "$spool_destination/privkey.pem" spool-privkey \
            "$spool_private_rollback" || restore_status=1
        rm -f -- "$spool_certificate_new" "$spool_private_new"
    fi

    if [ "$reload_attempted" = true ]; then
        rollback_configuration_valid=true
        nginx -t || rollback_configuration_valid=false
        if [ "$certificate_target" = mail ]; then
            postfix check || rollback_configuration_valid=false
            doveconf -c /etc/dovecot/dovecot.conf -n >/dev/null \
                || rollback_configuration_valid=false
        fi
        if [ "$rollback_configuration_valid" = true ]; then
            reload_active_services || restore_status=1
        else
            restore_status=1
        fi
    fi

    if [ "$spool_destination_created" = true ]; then
        rmdir "$spool_destination" 2>/dev/null || restore_status=1
    fi
    if [ "$destination_created" = true ]; then
        rmdir "$destination" 2>/dev/null || restore_status=1
    fi
    return "$restore_status"
}

finish() {
    deployment_status=$?
    trap - EXIT HUP INT TERM
    if [ "$completed" != true ] && [ "$changed" = true ]; then
        set +e
        restore_previous_certificate
        rollback_status=$?
        set -e
        if [ "$rollback_status" -eq 0 ]; then
            printf '%s\n' "Certificate deployment failed. The prior certificate was restored." >&2
        else
            printf '%s\n' "Certificate rollback failed. Immediate operator action is required." >&2
        fi
        deployment_status=1
    fi
    case "$work" in
        /run/mk8-certificate.*) rm -rf -- "$work" ;;
    esac
    exit "$deployment_status"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM

check_certificate_directory() {
    checked_directory=$1
    expected_group=$2
    expected_mode=${3#0}
    created_marker=$4
    if [ -L "$checked_directory" ]; then
        fail "A certificate directory must not be a symbolic link."
    fi
    if [ -e "$checked_directory" ] && [ ! -d "$checked_directory" ]; then
        fail "A certificate directory must be a directory."
    fi
    if [ ! -d "$checked_directory" ]; then
        install -d -o root -g "$expected_group" -m "$3" "$checked_directory"
        case "$created_marker" in
            destination_created) destination_created=true ;;
            spool_destination_created) spool_destination_created=true ;;
            *) fail "The certificate directory marker is not valid." ;;
        esac
        changed=true
    fi
    [ "$(stat -c '%U:%G' "$checked_directory")" = "root:$expected_group" ] \
        || fail "A certificate directory has unexpected ownership."
    [ "$(stat -c '%a' "$checked_directory")" = "$expected_mode" ] \
        || fail "A certificate directory has unexpected permissions."
}

snapshot_file() {
    source_path=$1
    snapshot_name=$2
    if [ -L "$source_path" ]; then
        fail "A managed certificate path must not be a symbolic link."
    fi
    if [ -e "$source_path" ] && [ ! -f "$source_path" ]; then
        fail "A managed certificate path must be a regular file."
    fi
    if [ -f "$source_path" ]; then
        [ "$(stat -c '%h' "$source_path")" -eq 1 ] \
            || fail "A managed certificate file must not have another hard link."
        cp -p -- "$source_path" "$work/$snapshot_name"
        : > "$work/$snapshot_name.present"
    fi
    : > "$work/$snapshot_name.checked"
}

check_pending_path() {
    pending_path=$1
    if [ -e "$pending_path" ] || [ -L "$pending_path" ]; then
        fail "A stale certificate transaction file exists."
    fi
}

openssl x509 -in "$lineage/fullchain.pem" -noout -checkend 1209600
openssl pkey -in "$lineage/privkey.pem" -noout -check \
    </dev/null >/dev/null
for required_name in $required_names; do
    if ! openssl x509 -in "$lineage/fullchain.pem" -noout \
        -checkhost "$required_name" >/dev/null 2>&1; then
        fail "The certificate does not cover $required_name."
    fi
done
openssl x509 -in "$lineage/fullchain.pem" -pubkey -noout \
    | openssl pkey -pubin -outform DER > "$work/certificate-public-key.der"
openssl pkey -in "$lineage/privkey.pem" -pubout -outform DER \
    > "$work/private-public-key.der"
cmp --silent "$work/certificate-public-key.der" "$work/private-public-key.der" \
    || fail "The certificate and private key do not match."
expected_fingerprint=$(openssl x509 -in "$lineage/fullchain.pem" \
    -noout -fingerprint -sha256)

systemctl is-active --quiet nginx.service \
    || fail "nginx must be active before certificate deployment."
nginx_active=true
if [ "$1" = mail ]; then
    systemctl is-active --quiet postfix.service \
        || fail "Postfix must be active before mail certificate deployment."
    systemctl is-active --quiet dovecot.service \
        || fail "Dovecot must be active before mail certificate deployment."
    postfix_active=true
    dovecot_active=true
fi

nginx -t
if [ "$1" = mail ]; then
    postfix check
    doveconf -c /etc/dovecot/dovecot.conf -n >/dev/null
fi

snapshot_file "$destination/fullchain.pem" destination-fullchain
snapshot_file "$destination/privkey.pem" destination-privkey
check_pending_path "$destination_certificate_new"
check_pending_path "$destination_private_new"
check_pending_path "$destination_certificate_rollback"
check_pending_path "$destination_private_rollback"
if [ -n "$spool_destination" ]; then
    snapshot_file "$spool_destination/fullchain.pem" spool-fullchain
    snapshot_file "$spool_destination/privkey.pem" spool-privkey
    check_pending_path "$spool_certificate_new"
    check_pending_path "$spool_private_new"
    check_pending_path "$spool_certificate_rollback"
    check_pending_path "$spool_private_rollback"
fi

check_certificate_directory "$destination" "$group" "$directory_mode" \
    destination_created
if [ -n "$spool_destination" ]; then
    check_certificate_directory "$spool_destination" "$group" "$directory_mode" \
        spool_destination_created
fi

changed=true
install -o "$owner" -g "$group" -m "$certificate_mode" \
    "$lineage/fullchain.pem" "$destination_certificate_new"
install -o "$owner" -g "$group" -m "$private_mode" \
    "$lineage/privkey.pem" "$destination_private_new"
mv -f -- "$destination_certificate_new" "$destination/fullchain.pem"
mv -f -- "$destination_private_new" "$destination/privkey.pem"

if [ -n "$spool_destination" ]; then
    install -o root -g "$group" -m "$certificate_mode" \
        "$destination/fullchain.pem" "$spool_certificate_new"
    install -o root -g "$group" -m "$private_mode" \
        "$destination/privkey.pem" "$spool_private_new"
    mv -f -- "$spool_certificate_new" "$spool_destination/fullchain.pem"
    mv -f -- "$spool_private_new" "$spool_destination/privkey.pem"
fi
sync -f "$destination"
if [ -n "$spool_destination" ]; then
    sync -f "$spool_destination"
fi

nginx -t
if [ "$1" = mail ]; then
    postfix check
    doveconf -c /etc/dovecot/dovecot.conf -n >/dev/null
fi

reload_attempted=true
reload_active_services

probe_certificate() {
    probe_name=$1
    server_name=$2
    shift 2
    probe_output="$work/presented-$probe_name.pem"
    probe_attempt=0
    while [ "$probe_attempt" -lt 5 ]; do
        : > "$probe_output"
        timeout 10 openssl s_client -showcerts -servername "$server_name" "$@" \
            </dev/null > "$probe_output" 2>/dev/null || true
        presented_fingerprint=$(openssl x509 -in "$probe_output" \
            -noout -fingerprint -sha256 2>/dev/null || true)
        if [ "$presented_fingerprint" = "$expected_fingerprint" ]; then
            return 0
        fi
        probe_attempt=$((probe_attempt + 1))
        [ "$probe_attempt" -eq 5 ] || sleep 1
    done
    fail "A local TLS endpoint did not present the new certificate: $probe_name"
}

for required_name in $required_names; do
    probe_certificate "https-$required_name" "$required_name" \
        -connect 127.0.0.1:443
done
if [ "$1" = mail ]; then
    probe_certificate smtp email.mk8n.com -starttls smtp -connect 127.0.0.1:25
    probe_certificate submissions email.mk8n.com -connect 127.0.0.1:465
    probe_certificate submission email.mk8n.com -starttls smtp -connect 127.0.0.1:587
    probe_certificate imaps email.mk8n.com -connect 127.0.0.1:993
fi

systemctl is-active --quiet nginx.service
if [ "$1" = mail ]; then
    systemctl is-active --quiet postfix.service
    systemctl is-active --quiet dovecot.service
fi

completed=true
printf '%s\n' "The mail certificate is installed and active on each local TLS endpoint."
