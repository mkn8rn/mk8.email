#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: deploy-mk8-certificate mail|matrix" >&2
    exit 2
fi

case "$1" in
    mail)
        lineage=${RENEWED_LINEAGE:-/etc/letsencrypt/live/mk8-mail}
        destination=/etc/mk8email/tls
        spool_destination=/var/spool/postfix/etc/mk8email/tls
        owner=root
        group=tlskeys
        directory_mode=0751
        certificate_mode=0444
        private_mode=0440
        required_names="mail.mk8n.com mta-sts.mk8n.com autoconfig.mk8n.com"
        getent group tlskeys >/dev/null || groupadd --system tlskeys
        ;;
    matrix)
        lineage=${RENEWED_LINEAGE:-/etc/letsencrypt/live/mk8-matrix}
        destination=/etc/matrix-synapse/tls
        spool_destination=
        owner=root
        group=root
        directory_mode=0700
        certificate_mode=0400
        private_mode=0400
        required_names="matrix.mkn8rn.com"
        ;;
    *)
        printf '%s\n' "The certificate target is not valid." >&2
        exit 2
        ;;
esac

if [ ! -f "$lineage/fullchain.pem" ] || [ ! -f "$lineage/privkey.pem" ]; then
    printf '%s\n' "The certificate lineage is incomplete." >&2
    exit 1
fi

work=$(mktemp -d /run/mk8-certificate.XXXXXX)
cleanup() {
    case "$work" in
        /run/mk8-certificate.*) rm -rf -- "$work" ;;
    esac
}
trap cleanup EXIT INT TERM

openssl x509 -in "$lineage/fullchain.pem" -noout -checkend 604800
openssl pkey -in "$lineage/privkey.pem" -noout -check
for required_name in $required_names; do
    if ! openssl x509 -in "$lineage/fullchain.pem" -noout \
        -checkhost "$required_name" >/dev/null 2>&1; then
        printf '%s\n' "The certificate does not cover $required_name." >&2
        exit 1
    fi
done
openssl x509 -in "$lineage/fullchain.pem" -pubkey -noout \
    | openssl pkey -pubin -outform DER > "$work/certificate-public-key.der"
openssl pkey -in "$lineage/privkey.pem" -pubout -outform DER > "$work/private-public-key.der"
if ! cmp --silent "$work/certificate-public-key.der" "$work/private-public-key.der"; then
    printf '%s\n' "The certificate and private key do not match." >&2
    exit 1
fi

install -d -o "$owner" -g "$group" -m "$directory_mode" "$destination"
if [ -f "$destination/fullchain.pem" ]; then
    cp -p "$destination/fullchain.pem" "$work/fullchain.old"
fi
if [ -f "$destination/privkey.pem" ]; then
    cp -p "$destination/privkey.pem" "$work/privkey.old"
fi

install -o "$owner" -g "$group" -m "$certificate_mode" "$lineage/fullchain.pem" "$destination/fullchain.pem.new"
install -o "$owner" -g "$group" -m "$private_mode" "$lineage/privkey.pem" "$destination/privkey.pem.new"
mv "$destination/fullchain.pem.new" "$destination/fullchain.pem"
mv "$destination/privkey.pem.new" "$destination/privkey.pem"

if [ -n "$spool_destination" ]; then
    install -d -o root -g "$group" -m "$directory_mode" "$spool_destination"
    if [ -f "$spool_destination/fullchain.pem" ]; then
        cp -p "$spool_destination/fullchain.pem" "$work/spool-fullchain.old"
    fi
    if [ -f "$spool_destination/privkey.pem" ]; then
        cp -p "$spool_destination/privkey.pem" "$work/spool-privkey.old"
    fi
    install -o root -g "$group" -m "$certificate_mode" "$destination/fullchain.pem" "$spool_destination/fullchain.pem"
    install -o root -g "$group" -m "$private_mode" "$destination/privkey.pem" "$spool_destination/privkey.pem"
fi

valid=true
nginx -t || valid=false
if [ "$1" = mail ] && [ -f /etc/postfix/main.cf ]; then
    postfix check || valid=false
    doveconf -c /etc/dovecot/dovecot.conf -n >/dev/null || valid=false
fi

if [ "$valid" != true ]; then
    if [ -f "$work/fullchain.old" ]; then
        cp -p "$work/fullchain.old" "$destination/fullchain.pem"
    else
        rm -f -- "$destination/fullchain.pem"
    fi
    if [ -f "$work/privkey.old" ]; then
        cp -p "$work/privkey.old" "$destination/privkey.pem"
    else
        rm -f -- "$destination/privkey.pem"
    fi
    if [ -n "$spool_destination" ]; then
        if [ -f "$work/spool-fullchain.old" ]; then
            cp -p "$work/spool-fullchain.old" "$spool_destination/fullchain.pem"
        else
            rm -f -- "$spool_destination/fullchain.pem"
        fi
        if [ -f "$work/spool-privkey.old" ]; then
            cp -p "$work/spool-privkey.old" "$spool_destination/privkey.pem"
        else
            rm -f -- "$spool_destination/privkey.pem"
        fi
    fi
    printf '%s\n' "Certificate validation failed. The prior certificate was restored." >&2
    exit 1
fi

systemctl reload nginx.service
if [ "$1" = mail ]; then
    if systemctl is-active --quiet postfix.service; then
        systemctl reload postfix.service || true
    fi
    if systemctl is-active --quiet dovecot.service; then
        systemctl reload dovecot.service || true
    fi
fi
