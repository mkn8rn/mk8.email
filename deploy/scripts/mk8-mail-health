#!/bin/sh
set -eu

deep=false
strict=false
for option in "$@"; do
    case "$option" in
        --deep) deep=true ;;
        --strict) strict=true ;;
        *)
            printf '%s\n' "Usage: mk8-mail-health [--deep] [--strict]" >&2
            exit 2
            ;;
    esac
done

state_directory=/var/lib/mk8-mail-health
state_file=$state_directory/status
status_json=$state_directory/status.json
backup_lock=/run/lock/mk8-backup.lock
exec 8>"$backup_lock"
if ! flock --shared --nonblock 8; then
    printf '%s\n' "The mail health check was skipped during a backup."
    exit 0
fi

errors=$(mktemp /run/mk8-mail-health.XXXXXX)
queue_data=$(mktemp /run/mk8-mail-queue.XXXXXX)
install -d -o root -g mk8email -m 2750 "$state_directory"
status_snapshot=$(mktemp "$state_directory/status.json.XXXXXX")
trap 'rm -f -- "$errors" "$queue_data" "$status_snapshot"' EXIT INT TERM

check_epoch=$(date +%s)
queue_count=0
oldest_age=null
used_percent=null
backup_age=null
signature_age=null
mail_certificate_remaining=null
admin_certificate_remaining=null

record_error() {
    printf '%s\n' "$1" >> "$errors"
}

certificate_remaining() {
    certificate_path=$1
    not_after=$(openssl x509 -in "$certificate_path" -noout -enddate 2>/dev/null) || {
        printf '%s\n' null
        return
    }
    expiry_epoch=$(date --date="${not_after#notAfter=}" +%s 2>/dev/null) || {
        printf '%s\n' null
        return
    }
    printf '%s\n' "$((expiry_epoch - check_epoch))"
}

write_status_snapshot() {
    health_state=$1
    checked_at=$(date --utc +%Y-%m-%dT%H:%M:%SZ)
    error_count=$(wc -l < "$errors" | tr -d ' ')
    printf '{"state":"%s","checkedAt":"%s","queueCount":%s,"oldestQueuedMessageSeconds":%s,"mailStorageUsedPercent":%s,"backupExportAgeSeconds":%s,"clamSignatureAgeSeconds":%s,"mailCertificateRemainingSeconds":%s,"adminCertificateRemainingSeconds":%s,"errorCount":%s}\n' \
        "$health_state" "$checked_at" "$queue_count" "$oldest_age" "$used_percent" \
        "$backup_age" "$signature_age" "$mail_certificate_remaining" \
        "$admin_certificate_remaining" "$error_count" > "$status_snapshot"
    chmod 0640 "$status_snapshot"
    mv -f -- "$status_snapshot" "$status_json"
}

for service_name in postgresql.service postfix.service dovecot.service rspamd.service \
    clamav-daemon.service clamav-freshclam.service valkey-server.service \
    mk8email-admin.service nginx.service nftables.service fail2ban.service \
    mk8-backup.timer mk8-mail-health.timer dailyaidecheck.timer; do
    systemctl is-active --quiet "$service_name" || record_error "$service_name is not active."
done

for completed_service in mk8-backup.service dailyaidecheck.service; do
    service_result=$(systemctl show "$completed_service" --property=Result --value 2>/dev/null || true)
    [ "$service_result" = success ] || record_error "$completed_service did not finish successfully."
done

pg_isready --host=127.0.0.1 --port=5432 --dbname=mk8email --quiet \
    || record_error "PostgreSQL is not ready."
valkey-cli -h 127.0.0.1 -p 6379 ping 2>/dev/null | grep -qx PONG \
    || record_error "Valkey is not ready."
clamdscan --config-file=/etc/clamav/clamd.conf --ping 1 >/dev/null 2>&1 \
    || record_error "ClamAV is not ready."
signature_path=$(find /var/lib/clamav -maxdepth 1 -type f \
    \( -name '*.cvd' -o -name '*.cld' \) -printf '%T@ %p\n' \
    | sort -nr | sed -n '1s/^[^ ]* //p')
if [ -n "$signature_path" ]; then
    signature_epoch=$(stat -c %Y "$signature_path")
    signature_age=$((check_epoch - signature_epoch))
    if [ "$signature_age" -lt 0 ]; then
        signature_age=0
        record_error "A ClamAV signature timestamp is in the future."
    elif [ "$signature_age" -gt 172800 ]; then
        record_error "ClamAV signatures are older than two days."
    fi
else
    record_error "ClamAV signatures are not available."
fi
if [ -s /etc/mk8email/secrets/backup-age-recipient ]; then
    latest_export=$(find /var/backups/mk8-export -maxdepth 1 -type f \
        -name '*.tar.gz.age' -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | sed -n '1s/^[^ ]* //p')
    if [ -z "$latest_export" ]; then
        record_error "An encrypted backup export is not available."
    else
        export_epoch=$(stat -c %Y "$latest_export")
        backup_age=$((check_epoch - export_epoch))
        if [ "$backup_age" -lt 0 ]; then
            backup_age=0
            record_error "The encrypted backup timestamp is in the future."
        elif [ "$backup_age" -gt 172800 ]; then
            record_error "The encrypted backup export is older than two days."
        fi
    fi
fi

if postqueue -j > "$queue_data" 2>/dev/null; then
    queue_count=$(wc -l < "$queue_data" | tr -d ' ')
    [ "$queue_count" -le 100 ] || record_error "The Postfix queue contains more than 100 messages."
    oldest=$(sed -n 's/.*"arrival_time":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$queue_data" | sort -n | head -n 1)
    if [ -n "$oldest" ]; then
        oldest_age=$((check_epoch - oldest))
        if [ "$oldest_age" -lt 0 ]; then
            oldest_age=0
            record_error "A Postfix queue timestamp is in the future."
        elif [ "$oldest_age" -gt 86400 ]; then
            record_error "The Postfix queue contains a message older than one day."
        fi
    fi
else
    record_error "The Postfix queue is not available."
fi

used_percent=$(df -P /var/vmail | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')
case "$used_percent" in
    ''|*[!0-9]*)
        used_percent=null
        record_error "Mail storage use is not available."
        ;;
    *)
        [ "$used_percent" -lt 90 ] || record_error "Mail storage is at least 90 percent full."
        ;;
esac
openssl x509 -in /etc/mk8email/tls/fullchain.pem -noout -checkend 1209600 >/dev/null 2>&1 \
    || record_error "The mail certificate expires within 14 days."
openssl x509 -in /etc/mk8email/tls/fullchain.pem -noout \
    -checkhost email.mk8n.com >/dev/null 2>&1 \
    || record_error "The mail certificate does not cover email.mk8n.com."
openssl x509 -in /etc/mk8email/admin-tls/fullchain.pem -noout -checkend 1209600 >/dev/null 2>&1 \
    || record_error "The administrator certificate expires within 14 days."
openssl x509 -in /etc/mk8email/admin-tls/fullchain.pem -noout \
    -checkhost admin.mk8n.com >/dev/null 2>&1 \
    || record_error "The administrator certificate does not cover admin.mk8n.com."
mail_certificate_remaining=$(certificate_remaining /etc/mk8email/tls/fullchain.pem)
admin_certificate_remaining=$(certificate_remaining /etc/mk8email/admin-tls/fullchain.pem)
curl --silent --fail --insecure --max-time 10 \
    --noproxy '*' \
    --resolve admin.mk8n.com:8443:@@MK8_SERVER_IPV4@@ \
    https://admin.mk8n.com:8443/health/ready >/dev/null \
    || record_error "The administrator dashboard is not ready."

active_domains=$(runuser -u postgres -- psql --dbname=mk8email --no-psqlrc \
    --tuples-only --no-align \
    --command='SELECT a.domain FROM addresses a JOIN companies c ON c.id = a.company_id WHERE a.is_active AND c.is_active ORDER BY a.domain' \
    2>/dev/null) || {
    active_domains=
    record_error "The active domain list is not available."
}
for active_domain in $active_domains; do
    case "$active_domain" in
        *[!a-z0-9.-]*|.*|*..*|*.)
            record_error "An active domain name is not safe."
            continue
            ;;
    esac
    domain_directory=/etc/mk8email/domains/$active_domain
    selector_file=$domain_directory/dkim-selector
    if [ ! -s "$domain_directory/prepared" ] || [ ! -s "$selector_file" ]; then
        record_error "The active domain $active_domain is not prepared."
        continue
    fi
    domain_selector=$(sed -n '1p' "$selector_file")
    case "$domain_selector" in
        ''|*[!a-z0-9]*)
            record_error "The active domain $active_domain has an invalid DKIM selector."
            continue
            ;;
    esac
    domain_key=/etc/mk8email/dkim/$active_domain/$domain_selector.private.pem
    grep -Fx "$active_domain $domain_selector" /etc/rspamd/dkim_selectors.map >/dev/null 2>&1 \
        || record_error "The active domain $active_domain is missing from the selector map."
    grep -Fx "$active_domain $domain_key" /etc/rspamd/dkim_paths.map >/dev/null 2>&1 \
        || record_error "The active domain $active_domain is missing from the key map."
    runuser -u _rspamd -- test -r "$domain_key" \
        || record_error "Rspamd cannot read the signing key for $active_domain."
    domain_certificate=$domain_directory/tls/fullchain.pem
    domain_private_key=$domain_directory/tls/privkey.pem
    openssl x509 -in "$domain_certificate" -noout -checkend 1209600 >/dev/null 2>&1 \
        || record_error "The discovery certificate for $active_domain expires within 14 days."
    openssl pkey -in "$domain_private_key" -noout -check </dev/null >/dev/null 2>&1 \
        || record_error "The discovery private key for $active_domain is not valid."
    for discovery_name in "autoconfig.$active_domain" "mta-sts.$active_domain"; do
        openssl x509 -in "$domain_certificate" -noout \
            -checkhost "$discovery_name" >/dev/null 2>&1 \
            || record_error "The discovery certificate does not cover $discovery_name."
    done
    [ -s "/etc/nginx/mk8email-domains.d/$active_domain.conf" ] \
        || record_error "The nginx configuration for $active_domain is missing."
    curl --silent --fail --insecure --max-time 10 --noproxy '*' \
        --resolve "autoconfig.$active_domain:443:127.0.0.1" \
        "https://autoconfig.$active_domain/mail/config-v1.1.xml" >/dev/null \
        || record_error "The autoconfiguration endpoint for $active_domain is not ready."
    curl --silent --fail --insecure --max-time 10 --noproxy '*' \
        --resolve "mta-sts.$active_domain:443:127.0.0.1" \
        "https://mta-sts.$active_domain/.well-known/mta-sts.txt" >/dev/null \
        || record_error "The MTA-STS endpoint for $active_domain is not ready."
done

if [ "$deep" = true ]; then
    postfix check >/dev/null 2>&1 || record_error "The Postfix configuration is not valid."
    doveconf -c /etc/dovecot/dovecot.conf -n >/dev/null 2>&1 \
        || record_error "The Dovecot configuration is not valid."
    rspamadm configtest --config=/etc/rspamd/rspamd.conf --strict --quiet >/dev/null 2>&1 \
        || record_error "The Rspamd configuration is not valid."
    clamconf --config-dir=/etc/clamav --non-default >/dev/null 2>&1 \
        || record_error "The ClamAV configuration is not valid."
    nginx -t >/dev/null 2>&1 || record_error "The nginx configuration is not valid."
    nft -c -f /etc/nftables.conf >/dev/null 2>&1 \
        || record_error "The nftables configuration is not valid."
    /usr/local/lib/mk8email/tests/host_hardening_smoke >/dev/null 2>&1 \
        || record_error "The host attack-surface controls are not valid."
    /usr/local/sbin/prune-native-releases --check >/dev/null 2>&1 \
        || record_error "The immutable release retention state is not valid."
    runuser -u postfix -- /usr/lib/postgresql/17/bin/psql --dbname=mk8email --no-psqlrc --command='SELECT 1 FROM addresses LIMIT 1' >/dev/null 2>&1 \
        || record_error "Postfix cannot read its database maps."
    runuser -u dovecot -- /usr/lib/postgresql/17/bin/psql --dbname=mk8email --no-psqlrc --command='SELECT 1 FROM users LIMIT 1' >/dev/null 2>&1 \
        || record_error "Dovecot cannot read its authentication data."
fi

previous_status=UNKNOWN
previous_key=UNKNOWN
if [ -f "$state_file" ]; then
    previous_status=$(cut -d' ' -f1 "$state_file")
    previous_key=$(cut -d' ' -f1-2 "$state_file")
fi

if [ ! -s "$errors" ]; then
    if [ "$previous_status" != HEALTHY ]; then
        logger --priority=mail.notice --tag=mk8-mail-health "The mail stack recovered."
    fi
    printf 'HEALTHY %s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" > "$state_file.new"
    mv "$state_file.new" "$state_file"
    write_status_snapshot healthy
    printf '%s\n' "The mail stack is healthy."
    exit 0
fi

error_hash=$(sha256sum "$errors" | cut -d' ' -f1)
current="UNHEALTHY $error_hash"
printf '%s %s\n' "$current" "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" > "$state_file.new"
mv "$state_file.new" "$state_file"
write_status_snapshot unhealthy

if [ "$previous_key" != "$current" ]; then
    summary=$(tr '\n' ' ' < "$errors")
    logger --priority=mail.err --tag=mk8-mail-health -- "$summary"
    cat "$errors" >&2
    exit 1
fi

if [ "$strict" = true ]; then
    cat "$errors" >&2
    exit 1
fi

exit 0
