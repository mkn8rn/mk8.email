#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: aide_alert_smoke ADMIN_PASSWORD_FILE" >&2
    exit 2
fi
admin_password_file=$1
test -s "$admin_password_file"

# shellcheck disable=SC1091
. /etc/default/aide
: "${FQDN:?AIDE FQDN is not configured}"
: "${MAILTO:?AIDE recipient is not configured}"

subject="mk8-aide-alert-smoke-$(date --utc +%Y%m%dT%H%M%SZ)-$$"
printf '%s\n' "This local message verifies AIDE alert delivery." \
    | runuser -u _aide -- env -u TMPDIR s-nail \
        -Smta=smtp://_aide@localhost \
        -Ssmtp-auth=none \
        -Sv15-compat \
        -Snosave \
        -Sfrom="AIDE on $FQDN <root@$FQDN>" \
        -s "$subject" "$MAILTO"

/usr/local/lib/mk8email/tests/mail_smoke.py subject-receive \
    --account "$MAILTO" \
    --subject "$subject" \
    --admin-password-file "$admin_password_file"
printf '%s\n' "AIDE alert delivery and cleanup passed."
